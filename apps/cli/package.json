{
	"name": "@tiny-chat/cli",
	"type": "module",
	"scripts": {
		"dev": "tsx --watch src/index.ts",
		"build": "tsup",
		"build:bun": "bun build --compile ./src/index.ts --outfile ./dist/tiny-chat-bun --env inline"
	},
	"bin": {
		"tiny-chat": "./dist/index.js"
	},
	"dependencies": {
		"@napi-rs/keyring": "^1.3.0",
		"@tanstack/react-query": "^5.101.2",
		"@tiny-chat/client": "workspace:*",
		"@tiny-chat/core": "workspace:*",
		"@tiny-chat/server": "workspace:*",
		"@trpc/tanstack-react-query": "^11.18.0",
		"chalk": "^6.0.0",
		"cli-spinners": "2.9.2",
		"clipboardy": "^5.3.2",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"ink": "^7.1.1",
		"ink-picture": "^2.1.0",
		"ink-spinner": "^5.0.0",
		"ink-task-list": "^2.0.0",
		"marked": "^15.0.12",
		"marked-terminal": "^7.3.0",
		"react": "^19.2.7",
		"react-ink-textarea": "^0.3.0",
		"string-width": "^8.2.2",
		"terminal-link": "^5.0.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"react-devtools-core": "^7.0.1",
		"tsup": "^8.5.1"
	}
