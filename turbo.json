{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"]
		},
		"@tiny-chat/tauri#lint": {
			"inputs": [
				"src/**/*.rs",
				"build.rs",
				"Cargo.toml",
				"Cargo.lock",
				"tauri.conf.json"
			],
			"outputs": ["target/**/*.rs", "target/**/*.d"],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"@tiny-chat/tauri#typecheck": {
			"inputs": [
				"src/**/*.rs",
				"build.rs",
				"Cargo.toml",
				"Cargo.lock",
				"tauri.conf.json"
			],
			"outputs": ["target/**/*.rs", "target/**/*.d"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"@tiny-chat/tauri#test": {
			"inputs": [
				"src/**/*.rs",
				"build.rs",
				"Cargo.toml",
				"Cargo.lock",
				"tauri.conf.json"
			],
			"outputs": ["target/**/*.rs", "target/**/*.d"],
			"cache": true
		},
		"smoketest": {
			"dependsOn": ["^smoketest"]
		}
	}
}
