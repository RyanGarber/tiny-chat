{
	"name": "@tiny-chat/app",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoketest": "node scripts/smoketest.ts",
		"postinstall": "playwright install --with-deps --no-shell chromium"
	},
	"imports": {
		"#app/*": "./src/*",
		"#server/*": "@tiny-chat/server/*",
		"#client/*": "@tiny-chat/client/*",
		"#core/*": "@tiny-chat/core/src/*"
	},
	"dependencies": {
		"@ai-sdk/provider": "^4.0.17",
		"@browser-ai/web-llm": "^3.0.3",
		"@gfazioli/mantine-json-tree": "^3.4.2",
		"@mantine/carousel": "^9.6.1",
		"@mantine/core": "^9.6.1",
		"@mantine/dates": "^9.6.1",
		"@mantine/dropzone": "^9.6.1",
		"@mantine/hooks": "^9.6.1",
		"@mantine/modals": "^9.6.1",
		"@mantine/spotlight": "^9.6.1",
		"@mlc-ai/web-llm": "^0.2.85",
		"@phosphor-icons/react": "^2.1.10",
		"@streamdown/code": "^1.1.1",
		"@streamdown/mermaid": "^1.0.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.103.1",
		"@tanstack/react-query-devtools": "^5.103.1",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"@tiny-chat/client": "workspace:*",
		"@tiny-chat/core": "workspace:*",
		"@tiny-chat/server": "workspace:*",
		"@tiptap/extension-blockquote": "^3.31.3",
		"@tiptap/extension-code-block": "^3.31.3",
		"@tiptap/extension-document": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@tiptap/suggestion": "^3.31.3",
		"@use-gesture/react": "^10.3.1",
		"@vidstack/react": "^1.15.6",
		"dayjs": "^1.11.23",
		"events": "^3.3.0",
		"katex": "^0.18.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"streamdown": "^2.6.0",
		"tailwind-preset-mantine": "^4.1.0",
		"tailwindcss": "^4.3.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "^0.2.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser-playwright": "^5.0.1",
