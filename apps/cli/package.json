{
	"name": "cli",
	"private": true,
	"type": "module",
	"imports": {
		"#core/*": "core/*",
		"#client/*": "client/*",
		"#tui/*": "tui/*",
		"#cli/*": "./src/*"
	},
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"dev": "bun ./scripts/dev.ts",
		"build": "bun ./scripts/build.ts",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoketest": "bun ./scripts/smoketest.ts"
	},
	"dependencies": {
		"@babel/core": "^8.0.6",
		"@napi-rs/keyring": "^2.1.0",
		"@tanstack/react-query": "^5.104.1",
		"client": "workspace:*",
		"core": "workspace:*",
		"ink": "8",
		"react": "^19.3.0",
		"tui": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"bun": "^1.4.2",
		"bun-types": "^1.4.2"
	}
}
