{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tiny Chat",
	"version": "0.7.6",
	"identifier": "dev.ryangarber.chat",
	"app": {
		"windows": [
			{
				"title": "Tiny Chat",
				"width": 1280,
				"height": 720,
				"titleBarStyle": "Transparent"
			}
		],
		"security": {
			"csp": null
		},
		"withGlobalTauri": false
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"active": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQzUyOUU0ODNBMTg1QUUKUldTdWhhR0Q1Q25GdXN6d2dzMnR3MDRiT0ZURzVSZHByYzQ0SjdoSnhsZE1qWVVBSFJCS3VOeGoK",
			"endpoints": [
				"https://github.com/RyanGarber/tiny-chat/releases/latest/download/latest.json"
			]
		}
	},
	"build": {
		"beforeDevCommand": "pnpm run --filter @tiny-chat/app dev",
		"devUrl": "http://localhost:8010",
		"beforeBuildCommand": "pnpm run --filter @tiny-chat/app build",
		"frontendDist": "../../packages/app/dist"
	}
}
